# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# One of the private keys printed by Ganache on startup (each has
# 100 test ETH pre-funded -- these are throwaway local-only keys, but
# still keep them out of source control / screenshots as good practice).
PRIVATE_KEY=0xyour_ganache_private_key_here

# Ganache JSON-RPC endpoint
GANACHE_RPC_URL=http://127.0.0.1:8545

# Uncomment to smoke-test against the small bundled sample dataset
# instead of the full 55,500-row healthcare_dataset.csv:
# DATASET_CSV_PATH=dataset/healthcare/healthcare_dataset_sample.csv

# Ollama model name
OLLAMA_MODEL_NAME=llama3.2:3b
